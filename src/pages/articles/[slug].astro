---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { stageById, path } from '../../data/stages';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const stage = stageById[article.data.stage];
const date = article.data.publishedLabel || article.data.published.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title={article.data.title} description={article.data.description}>
  <article class="shell article-page">
    <header class="article-header">
      <a class="breadcrumb" href={path(`/workflow/${stage.id}/`)}>← {stage.label}</a>
      <p class="eyebrow">{stage.number} / {stage.label.toUpperCase()}</p>
      <h1>{article.data.title}</h1>
      <p class="article-deck">{article.data.description}</p>
      <p class="article-meta"><time datetime={article.data.published.toISOString()}>{date}</time>{article.data.updated && <span> · Updated {article.data.updated.toLocaleDateString('en-US', { timeZone: 'UTC' })}</span>}</p>
    </header>
    <div class="prose"><Content /></div>
    <div class="endnote">
      <span>End of article</span>
      <a href={path(`/workflow/${stage.id}/`)}>More in {stage.label} <span aria-hidden="true">↗</span></a>
    </div>
  </article>
</Base>

<script>
  const frames = Array.from(document.querySelectorAll<HTMLIFrameElement>('iframe[data-auto-resize="delta"]'));
  window.addEventListener('message', (event) => {
    if (event.data?.type !== 'ai4la-delta-height' || !Number.isFinite(event.data.height)) return;
    const frame = frames.find((candidate) => event.source === candidate.contentWindow);
    if (frame) frame.style.height = Math.max(700, Math.min(3500, event.data.height + 4)) + 'px';
  });
  for (const frame of frames) {
    const measure = () => frame.contentWindow?.postMessage({ type: 'ai4la-delta-measure' }, '*');
    frame.addEventListener('load', measure);
    measure();
  }
</script>

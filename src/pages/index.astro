---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { stages, path, stageById } from '../data/stages';

const latest = (await getCollection('articles'))
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
  .slice(0, 4);
---
<Base title="AI for Landscape Architecture" description="Practical articles on using AI throughout the landscape architecture design workflow.">
  <div class="shell">
    <section class="intro" aria-labelledby="intro-heading">
      <p class="eyebrow">FIELD NOTES / METHODS / DESIGN</p>
      <h1 id="intro-heading">AI for<br /><em>Landscape Architecture.</em></h1>
      <div class="intro-bottom">
        <p>Practical ways to use AI across the design process, from reading a site to presenting a proposal.</p>
        <a class="text-link" href={path('/#workflow')}>Explore the workflow <span aria-hidden="true">↘</span></a>
      </div>
    </section>

    <section class="section" id="workflow" aria-labelledby="workflow-heading">
      <div class="section-head">
        <h2 id="workflow-heading">Explore by workflow</h2>
        <span>01 — 06</span>
      </div>
      <div class="stage-grid">
        {stages.map((stage) => (
          <a class="stage-tile" href={path(`/workflow/${stage.id}/`)}>
            <span class="tile-top"><span>{stage.number} / {stage.short}</span><span aria-hidden="true">↗</span></span>
            <span class="tile-name">{stage.label}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="latest-heading">
      <div class="section-head">
        <h2 id="latest-heading">Latest articles</h2>
        <a class="quiet-link" href={path('/articles/')}>All articles <span aria-hidden="true">↗</span></a>
      </div>
      <div class="article-list">
        {latest.map((article) => (
          <a class="article-row" href={path(`/articles/${article.id}/`)}>
            <span class="row-category">{stageById[article.data.stage].label}</span>
            <span class="row-title">{article.data.title}</span>
            <span class="row-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>

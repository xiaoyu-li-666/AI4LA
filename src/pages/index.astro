---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { stages, path, stageById } from '../data/stages';
import { Image } from 'astro:assets';
import defaultThumbnail from '../assets/editorial/gis-workflow.svg';

const latest = (await getCollection('articles'))
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime())
  .slice(0, 4);
---
<Base title="AI for Landscape Architecture" description="Practical articles on using AI throughout the landscape architecture design workflow.">
  <div class="shell">
    <section class="intro" aria-labelledby="intro-heading">
      <img class="hero-scenes" src={path('/images/home-scenes.svg')} alt="" aria-hidden="true" width="900" height="400" fetchpriority="high" />
      <p class="eyebrow">FIELD NOTES / METHODS / DESIGN</p>
      <h1 id="intro-heading">AI for<br /><em>Landscape<br />Architecture.</em></h1>
      <div class="intro-bottom">
        <p>Practical ways to use AI across the design process, from reading a site to presenting a proposal.</p>
        <a class="text-link" href="#latest">Read the latest <span aria-hidden="true">↘</span></a>
      </div>
    </section>

    <div class="home-content">
    <section class="section latest-section" id="latest" aria-labelledby="latest-heading">
      <div class="section-head">
        <h2 id="latest-heading">Latest articles</h2>
        <a class="quiet-link" href={path('/articles/')}>All articles <span aria-hidden="true">↗</span></a>
      </div>
      <div class="featured-articles">
        {latest.slice(0, 3).map((article) => (
          <article class="featured-article">
            <a class="featured-link" href={path(`/articles/${article.id}/`)}>
              <div class="article-thumbnail">
                <Image src={article.data.thumbnail || defaultThumbnail} alt={article.data.thumbnailAlt || `Illustration for ${article.data.title}`} width={640} height={400} loading="lazy" />
              </div>
              <span class="row-category">{stageById[article.data.stage].label}</span>
              <h3>{article.data.title}</h3>
              <p>{article.data.description}</p>
              <div class="featured-meta">
                <time datetime={article.data.published.toISOString()}>{article.data.published.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</time>
                <span aria-hidden="true">↗</span>
              </div>
            </a>
          </article>
        ))}
      </div>
      {latest.length > 3 && <div class="article-list more-articles">
        {latest.slice(3).map((article) => (
          <a class="article-row" href={path(`/articles/${article.id}/`)}>
            <span class="row-category">{stageById[article.data.stage].label}</span>
            <span class="row-title">{article.data.title}</span>
            <span class="row-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>}
    </section>
    <aside class="section workflow-sidebar" id="workflow" aria-labelledby="workflow-heading">
      <div class="section-head">
        <h2 id="workflow-heading">Explore by workflow</h2>
        <span>01 — 06</span>
      </div>
      <div class="stage-grid">
        {stages.map((stage) => (
          <a class="stage-tile" href={path(`/workflow/${stage.id}/`)}>
            <span class="tile-top"><span>{stage.number} / {stage.short}</span><span aria-hidden="true">↗</span></span>
            <span class="tile-name">{stage.label}</span>
          </a>
        ))}
      </div>
    </aside>
    </div>
  </div>
</Base>

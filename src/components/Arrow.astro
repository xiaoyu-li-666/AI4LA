---
interface Props {
  direction?: 'up-right' | 'down-right' | 'down' | 'left' | 'right';
  class?: string;
}
const { direction = 'up-right', class: className } = Astro.props;
const paths = {
  'up-right': 'M5 19 19 5M5 5h14v14',
  'down-right': 'M5 5l14 14M5 19h14V5',
  down: 'M12 3v18M5 14l7 7 7-7',
  left: 'M21 12H3m7-7-7 7 7 7',
  right: 'M3 12h18m-7-7 7 7-7 7',
};
---
<svg class:list={['ui-arrow', className]} width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  <path d={paths[direction]} />
</svg>

---
import Arrow from './Arrow.astro';
---
<dialog class="intro-splash" data-intro-splash aria-labelledby="splash-title" data-phase="scattered">
  <h2 class="splash-sr-only" id="splash-title">AI4LA — AI for Landscape Architecture</h2>
  <div class="splash-topline">
    <span class="splash-mark" aria-hidden="true">
      <svg width="22" height="25" viewBox="0 0 22 25" fill="none"><path d="m11 1 10 6v11l-10 6-10-6V7L11 1Z" stroke="currentColor" /><path d="m1 7 10 6 10-6M11 13v11" stroke="currentColor" /></svg>
      AI4LA
    </span>
    <button class="splash-skip" data-intro-skip type="button">Skip intro <span><Arrow /></span></button>
  </div>
  <button class="splash-stage" data-intro-stage type="button" aria-label="Assemble AI4LA. Click, scroll, or press Enter.">
    <canvas class="splash-canvas" data-intro-canvas aria-hidden="true"></canvas>
    <span class="splash-explore">click to explore <span class="splash-explore-arrow"><Arrow /></span></span>
  </button>
  <div class="splash-bottomline">
    <p class="splash-caption">AI FOR<br />LANDSCAPE ARCHITECTURE</p>
    <p class="splash-instruction"><span data-intro-instruction>Click anywhere or scroll to assemble</span><span class="splash-instruction-icon"><Arrow direction="down" class="splash-arrow-down" /><Arrow class="splash-arrow-ready" /></span></p>
    <span class="splash-sequence" data-intro-sequence aria-hidden="true">01 / 02</span>
  </div>
  <p class="splash-sr-only" data-intro-status role="status" aria-live="polite"></p>
</dialog>
